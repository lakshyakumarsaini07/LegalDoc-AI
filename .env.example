# Google Gemini API key — get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Vector store backend: "faiss" (default, local file-based) or "supabase" (pgvector, shared/cloud)
VECTOR_STORE_BACKEND=faiss

# Required only when VECTOR_STORE_BACKEND=supabase. Apply supabase/schema.sql to your
# project first. Use the service_role key (server-side ingestion + queries), not anon.
SUPABASE_URL=
SUPABASE_KEY=
# SUPABASE_TABLE=legal_chunks
# SUPABASE_MATCH_FUNCTION=match_legal_chunks

# Optional overrides (defaults shown)
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_TEMPERATURE=0.2
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_DIM=384
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150
# RETRIEVER_TOP_K=5
# EVAL_SCORE_THRESHOLD=4.0
# EVAL_MAX_ITERATIONS=2
# API_HOST=0.0.0.0
# API_PORT=8000

# If set, /chat, /summarize, /generate, /refine require header `X-API-Key: <value>`.
# API_KEY=
# Comma-separated CORS origins, or "*" (default) for any.
# ALLOWED_ORIGINS=*
